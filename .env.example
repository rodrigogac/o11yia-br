# Environment configuration example

# Do NOT commit real secrets. Copy this file to .env and fill in real values.

# Backend API
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=sqlite:///./o11yia.db
LOG_LEVEL=INFO

# API Authentication
O11YIA_API_KEYS=dev-key-1,dev-key-2
O11YIA_ADMIN_KEY=dev-admin-key

# CORS
O11YIA_CORS_ORIGINS=http://localhost:8501

# Dashboard
DASHBOARD_PORT=8501
API_URL=http://localhost:8080

# Optional: disable auth for local development (NEVER in production)
# O11YIA_AUTH_DISABLED=true